# Selected TLS and QUIC for YouTube hostnames. Other Google rules follow.
--filter-tcp=443 --filter-l7=tls --hostlist=../profiles/youtube-core.txt --ip-id=zero {service-tls}
--new
--filter-udp=443 --filter-l7=quic --hostlist=../profiles/youtube-core.txt --dpi-desync=fake --dpi-desync-repeats={quic-repeats} --dpi-desync-fake-quic=quic_initial_www_google_com.bin
--new
--filter-udp=443 --filter-l7=quic --hostlist=../profiles/youtube.txt --dpi-desync=fake --dpi-desync-repeats=6 --dpi-desync-fake-quic=quic_initial_www_google_com.bin
--new
--filter-tcp=443 --filter-l7=tls --hostlist=../profiles/youtube.txt --ip-id=zero --dpi-desync=multisplit --dpi-desync-split-seqovl=681 --dpi-desync-split-pos=1 --dpi-desync-split-seqovl-pattern=tls_clienthello_www_google_com.bin
--new
--filter-tcp=80 --filter-l7=http --hostlist=../profiles/youtube.txt --dpi-desync=multisplit --dpi-desync-split-pos=method+2
