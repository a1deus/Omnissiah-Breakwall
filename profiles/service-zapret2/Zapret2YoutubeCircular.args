# Source: general (CIRCULAR1).bat. TLS sections scoped to Breakwall hostlists.
--name=youtube-tls --filter-tcp=443 --filter-l7=tls --hostlist="{profiles}/youtube-core.txt" --hostlist="{profiles}/youtube.txt"{exclude}
--in-range=-s34228
--out-range=-s34228
--payload=all
--lua-desync=circular:key=youtube-tls:nld=2:fails=2:time=120:retrans=2:reset
--payload=tls_client_hello
--lua-desync=tls_client_hello_clone:blob=ch_clone:fallback=tls_steamchat:sni_del:sni_first=winelab.ru:sni_snt_new=0:strategy=1
--lua-desync=fake:blob=ch_clone:repeats=6:tcp_ts=-600000:strategy=1
--lua-desync=multisplit:pos=sniext+1,midsld:seqovl=1:strategy=1
--lua-desync=fake:blob=tls_sferum:repeats=6:tcp_ts=-600000:strategy=2
--lua-desync=multisplit:pos=2:strategy=2
