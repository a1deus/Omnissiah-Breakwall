# Source: general (CIRCULAR1).bat. TLS sections scoped to Breakwall hostlists.
--name=discord-media-tls --filter-tcp={media-ports} --filter-l7=tls --hostlist-domains=discord.media{exclude}
--in-range=-s34228
--out-range=-s34228
--payload=all
--lua-desync=circular:key=dm:fails=2:time=120:retrans=2:reset
--payload=tls_client_hello
--lua-desync=tls_client_hello_clone:blob=ch_clone:fallback=tls_google:sni_del:sni_first=www.google.com:sni_snt_new=0:strategy=1
--lua-desync=fake:blob=ch_clone:repeats=6:tcp_ts=-600000:ip_id=zero:strategy=1
--lua-desync=fake:blob=tls_google:tls_mod=rnd,padencap:repeats=4:badsum:ip_id=zero:strategy=1
--lua-desync=multisplit:pos=sniext+1,midsld:seqovl=1:ip_id=zero:strategy=1
--lua-desync=fake:blob=stun:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:tcp_ts=-600000:strategy=2
--lua-desync=fake:blob=tls_google:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:tcp_ts=-600000:strategy=2
--lua-desync=multisplit:pos=2:strategy=2
--new
--name=discord-tls --filter-tcp=443 --filter-l7=tls --hostlist="{profiles}/discord.txt"{exclude}
--in-range=-s34228
--out-range=-s34228
--payload=all
--lua-desync=circular:key=gen:nld=2:fails=2:time=120:retrans=2:reset
--payload=tls_client_hello
--lua-desync=tls_client_hello_clone:blob=ch_clone:fallback=tls_google:sni_del:sni_first=www.google.com:sni_snt_new=0:strategy=1
--lua-desync=fake:blob=ch_clone:repeats=6:tcp_ts=-600000:ip_id=zero:strategy=1
--lua-desync=fake:blob=tls_google:tls_mod=rnd,padencap:repeats=4:badsum:ip_id=zero:strategy=1
--lua-desync=multisplit:pos=sniext+1,midsld:seqovl=1:ip_id=zero:strategy=1
--lua-desync=fake:blob=stun:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:tcp_ts=-600000:strategy=2
--lua-desync=fake:blob=tls_google:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:tcp_ts=-600000:strategy=2
--lua-desync=multisplit:pos=2:strategy=2
