# Native zapret2 recipes. Flowseal commit c756d2eabd2cb089138e350d567f9b1581ae0276 (2026-11-27).

[GENERAL]
Description=разбиение TLS
Web=--payload=tls_client_hello,http_req --lua-desync=multisplit:pos=1:seqovl=568:seqovl_pattern=tls_4pda
Quic=--payload=quic_initial --lua-desync=fake:blob=quic_google:repeats=6
Google=--payload=tls_client_hello --lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=tls_google:ip_id=zero
IpQuic=--payload=quic_initial --lua-desync=fake:blob=quic_google:repeats=6
Voice=--filter-l7=discord,stun --payload=discord_ip_discovery,stun --lua-desync=fake:blob=active_discord:repeats=6
Media=--payload=tls_client_hello --lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=tls_google

