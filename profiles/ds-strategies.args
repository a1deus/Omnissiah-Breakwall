[EXP]
Description=перекрытие TLS 480 Б
YouTubeDescription=подмена имени + QUIC
Web=--payload=tls_client_hello,http_req --lua-desync=fake:blob=tls_sferum:tcp_ts=-600000:repeats=4 --lua-desync=multisplit:pos=1:seqovl=480:seqovl_pattern=stun2
Quic=--payload=quic_initial --lua-desync=fake:blob=quic_google:repeats=11
Google=--payload=tls_client_hello --lua-desync=hostfakesplit:host=www.google.com:tcp_ts=-600000:ip_id=zero
IpQuic=--payload=quic_initial --lua-desync=fake:blob=quic_google:repeats=11
Voice=--filter-l7=discord,stun,unknown --out-range=-n4 --payload=discord_ip_discovery --lua-desync=fake:blob=quic_google:repeats=4 --lua-desync=fake:blob=active_discord:repeats=4 --payload=stun --lua-desync=fake:blob=active_discord:repeats=4 --payload=unknown --lua-desync=fake:blob=quic_google:repeats=4:payload=all --lua-desync=fake:blob=active_discord:repeats=4:payload=all
Media=--payload=tls_client_hello --lua-desync=fake:blob=tls_google:tcp_ts=-600000:repeats=8 --lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=tls_google

